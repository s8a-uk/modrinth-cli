{"schemaVersion":1,"path":"search","aliases":["project search"],"summary":"Search projects","description":"Searches projects. Values of one repeated flag are ORed, different flags are ANDed; each --category and each --facet is its own AND group. --facets passes the raw facets JSON instead (not combinable with the facet flags). More than 100 results are fetched in pages.","endpoints":[{"method":"GET","path":"/search","scope":null}],"args":[{"name":"query","required":false,"variadic":false,"help":"search text (at most 256 characters)"}],"flags":[{"name":"--type","type":"list","help":"project type, e.g. mod, modpack, resourcepack (repeatable, OR)"},{"name":"--loader","type":"list","help":"loader, e.g. fabric (repeatable, OR)"},{"name":"--game-version","type":"list","help":"game version, e.g. 1.20.1 (repeatable, OR)"},{"name":"--category","type":"list","help":"category (repeatable, AND)"},{"name":"--environment","type":"list","help":"environment (repeatable, OR)"},{"name":"--license","type":"list","help":"license id (repeatable, OR)"},{"name":"--author","type":"list","help":"author username (repeatable, OR)"},{"name":"--open-source","type":"bool","help":"only open-source projects"},{"name":"--facet","type":"list","help":"facet group, e.g. downloads>=1000; commas OR (repeatable, AND)"},{"name":"--facets","type":"string","help":"raw facets JSON, e.g. '[[\"categories:fabric\"]]'"},{"name":"--sort","type":"enum","values":["relevance","downloads","follows","newest","updated"],"help":"sort order (API default: relevance)"},{"name":"--limit","type":"int","default":"10","help":"number of hits, 1-1000"},{"name":"--offset","type":"int","default":"0","help":"hits to skip, 0-100000"}],"output":{"shape":"search_page","default_fields":["project_id","slug","title","description","project_type","author","downloads","follows","latest_version","date_modified"],"fields":["project_id","slug","title","description","project_type","all_project_types","author","author_id","organization","organization_id","categories","display_categories","versions","downloads","follows","icon_url","date_created","date_modified","latest_version","license","client_side","server_side","environment","disclosure_types","gallery","featured_gallery","color"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr search sodium","mdr search --type mod --loader fabric --game-version 1.20.1 --sort downloads --limit 5","mdr search shader --facet 'downloads>=100000' --fields slug,title,downloads","mdr search --facets '[[\"categories:fabric\"],[\"versions:1.20.1\"]]'"],"errors":["bad_request"]}
{"schemaVersion":1,"path":"project get","aliases":[],"summary":"Get one project by id or slug","description":"","endpoints":[{"method":"GET","path":"/project/{id|slug}","scope":null}],"args":[{"name":"id","required":true,"variadic":false,"help":"project id (8-char base62) or slug"}],"flags":[],"output":{"shape":"object","default_fields":["id","slug","title","description","project_type","downloads","followers","categories","loaders","license.id","client_side","server_side","status","updated","team","source_url"],"fields":["id","slug","project_type","team","organization","title","description","body","body_url","published","updated","approved","queued","status","requested_status","moderator_message.message","moderator_message.body","license.id","license.name","license.url","client_side","server_side","environment","downloads","followers","categories","additional_categories","game_versions","loaders","versions","icon_url","raw_icon_url","color","thread_id","monetization_status","issues_url","source_url","wiki_url","discord_url","donation_urls.id","donation_urls.platform","donation_urls.url","gallery.url","gallery.raw_url","gallery.featured","gallery.title","gallery.description","gallery.created","gallery.ordering"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr project get sodium","mdr project get sodium --full"],"errors":["not_found"]}
{"schemaVersion":1,"path":"project get-many","aliases":[],"summary":"Get several projects by id or slug","description":"Fetches up to 1000 projects, 100 per request. The output keeps the order of the arguments; ids that match nothing are left out and listed in a note on stderr (exit 0).","endpoints":[{"method":"GET","path":"/projects","scope":null}],"args":[{"name":"id","required":true,"variadic":true,"help":"project ids or slugs (1-1000)"}],"flags":[],"output":{"shape":"array","default_fields":["id","slug","title","description","project_type","downloads","followers","categories","loaders","license.id","client_side","server_side","status","updated","team","source_url"],"fields":["id","slug","project_type","team","organization","title","description","body","body_url","published","updated","approved","queued","status","requested_status","moderator_message.message","moderator_message.body","license.id","license.name","license.url","client_side","server_side","environment","downloads","followers","categories","additional_categories","game_versions","loaders","versions","icon_url","raw_icon_url","color","thread_id","monetization_status","issues_url","source_url","wiki_url","discord_url","donation_urls.id","donation_urls.platform","donation_urls.url","gallery.url","gallery.raw_url","gallery.featured","gallery.title","gallery.description","gallery.created","gallery.ordering"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr project get-many sodium lithium","mdr project get-many AANobbMI gvQqBUqZ --fields slug,downloads"],"errors":[]}
{"schemaVersion":1,"path":"project random","aliases":[],"summary":"Get random projects","description":"","endpoints":[{"method":"GET","path":"/projects_random","scope":null}],"args":[],"flags":[{"name":"--count","type":"int","default":"10","help":"number of projects, 1-100"}],"output":{"shape":"array","default_fields":["id","slug","title","description","project_type","downloads","followers","categories","loaders","license.id","client_side","server_side","status","updated","team","source_url"],"fields":["id","slug","project_type","team","organization","title","description","body","body_url","published","updated","approved","queued","status","requested_status","moderator_message.message","moderator_message.body","license.id","license.name","license.url","client_side","server_side","environment","downloads","followers","categories","additional_categories","game_versions","loaders","versions","icon_url","raw_icon_url","color","thread_id","monetization_status","issues_url","source_url","wiki_url","discord_url","donation_urls.id","donation_urls.platform","donation_urls.url","gallery.url","gallery.raw_url","gallery.featured","gallery.title","gallery.description","gallery.created","gallery.ordering"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr project random --count 3"],"errors":[]}
{"schemaVersion":1,"path":"project check","aliases":[],"summary":"Check that a project exists and get its id","description":"Resolves a slug (or id) to the project id. Exits 3 (not_found) when there is no such project.","endpoints":[{"method":"GET","path":"/project/{id|slug}/check","scope":null}],"args":[{"name":"id","required":true,"variadic":false,"help":"project id (8-char base62) or slug"}],"flags":[],"output":{"shape":"object","default_fields":null,"fields":["id"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr project check sodium"],"errors":["not_found"]}
{"schemaVersion":1,"path":"project dependencies","aliases":[],"summary":"List the projects and versions a project depends on","description":"Returns {\"projects\": [...], \"versions\": [...]}: the projects the project's versions depend on, and the specific versions they pin. Fields are projects.<project field> and versions.<version field>.","endpoints":[{"method":"GET","path":"/project/{id|slug}/dependencies","scope":null}],"args":[{"name":"id","required":true,"variadic":false,"help":"project id (8-char base62) or slug"}],"flags":[],"output":{"shape":"object","default_fields":["projects.id","projects.slug","projects.title","projects.project_type","versions.id","versions.project_id","versions.version_number"],"fields":["projects.id","projects.slug","projects.project_type","projects.team","projects.organization","projects.title","projects.description","projects.body","projects.body_url","projects.published","projects.updated","projects.approved","projects.queued","projects.status","projects.requested_status","projects.moderator_message.message","projects.moderator_message.body","projects.license.id","projects.license.name","projects.license.url","projects.client_side","projects.server_side","projects.environment","projects.downloads","projects.followers","projects.categories","projects.additional_categories","projects.game_versions","projects.loaders","projects.versions","projects.icon_url","projects.raw_icon_url","projects.color","projects.thread_id","projects.monetization_status","projects.issues_url","projects.source_url","projects.wiki_url","projects.discord_url","projects.donation_urls.id","projects.donation_urls.platform","projects.donation_urls.url","projects.gallery.url","projects.gallery.raw_url","projects.gallery.featured","projects.gallery.title","projects.gallery.description","projects.gallery.created","projects.gallery.ordering","versions.id","versions.project_id","versions.author_id","versions.name","versions.version_number","versions.changelog","versions.changelog_url","versions.date_published","versions.downloads","versions.version_type","versions.status","versions.requested_status","versions.featured","versions.game_versions","versions.loaders","versions.environment","versions.dependencies.version_id","versions.dependencies.project_id","versions.dependencies.file_name","versions.dependencies.dependency_type","versions.files.id","versions.files.hashes.sha1","versions.files.hashes.sha512","versions.files.url","versions.files.filename","versions.files.primary","versions.files.size","versions.files.file_type"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr project dependencies fabulously-optimized","mdr project dependencies sodium --fields projects.slug"],"errors":["not_found"]}
{"schemaVersion":1,"path":"project members","aliases":[],"summary":"List the team members of a project","description":"","endpoints":[{"method":"GET","path":"/project/{id|slug}/members","scope":null}],"args":[{"name":"id","required":true,"variadic":false,"help":"project id (8-char base62) or slug"}],"flags":[],"output":{"shape":"array","default_fields":["user.id","user.username","role","accepted","ordering"],"fields":["team_id","user.id","user.username","user.name","user.avatar_url","user.raw_avatar_url","user.bio","user.created","user.role","user.badges","user.campaigns","user.auth_providers","user.email","user.email_verified","user.has_password","user.has_totp","user.payout_data","user.stripe_customer_id","user.allow_friend_requests","user.eligibility_verified_at","user.github_id","role","permissions","accepted","payouts_split","ordering"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr project members sodium"],"errors":["not_found"]}
{"schemaVersion":1,"path":"project create","aliases":[],"summary":"Create a project from a JSON description","description":"Creates a project from --data, a JSON object with the fields of the API (slug, title, description, body, categories, client_side, server_side, license_id, project_type, ...; set is_draft to true), and an optional --icon. Prints the created project.","endpoints":[{"method":"POST","path":"/project","scope":"PROJECT_CREATE"}],"args":[],"flags":[{"name":"--data","type":"string","help":"project as a JSON object, from a file or stdin (required)"},{"name":"--icon","type":"string","help":"icon image: .png, .jpg, .jpeg, .bmp, .gif, .webp, .svg, .svgz or .rgb"}],"output":{"shape":"object","default_fields":["id","slug","title","description","project_type","downloads","followers","categories","loaders","license.id","client_side","server_side","status","updated","team","source_url"],"fields":["id","slug","project_type","team","organization","title","description","body","body_url","published","updated","approved","queued","status","requested_status","moderator_message.message","moderator_message.body","license.id","license.name","license.url","client_side","server_side","environment","downloads","followers","categories","additional_categories","game_versions","loaders","versions","icon_url","raw_icon_url","color","thread_id","monetization_status","issues_url","source_url","wiki_url","discord_url","donation_urls.id","donation_urls.platform","donation_urls.url","gallery.url","gallery.raw_url","gallery.featured","gallery.title","gallery.description","gallery.created","gallery.ordering"]},"mutating":"write","requires_yes":false,"supports_dry_run":true,"examples":["mdr project create --data project.json --icon icon.png --dry-run"],"errors":["auth_required","unauthorized","forbidden","not_found","bad_request"]}
{"schemaVersion":1,"path":"project edit","aliases":[],"summary":"Change fields of a project","description":"Sends only the given fields (PATCH). Values of --set are read like api -f. The default output of get does not include long text fields such as body or changelog; fetch them with --fields body (or --fields changelog) before editing them. Prints an ack on success.","endpoints":[{"method":"PATCH","path":"/project/{id|slug}","scope":"PROJECT_WRITE"}],"args":[{"name":"id","required":true,"variadic":false,"help":"project id (8-char base62) or slug"}],"flags":[{"name":"--set","type":"list","help":"set a field: key=value (repeatable); true/false/null, numbers and JSON ([...], {...}, \"...\") are sent as JSON, anything else as a string"},{"name":"--data","type":"string","help":"fields to change as a JSON object, from a file or stdin (instead of --set)"}],"output":{"shape":"ack","default_fields":null,"fields":[]},"mutating":"write","requires_yes":false,"supports_dry_run":true,"examples":["mdr project edit my-mod --set 'description=A better description'","mdr project edit my-mod --data changes.json --dry-run"],"errors":["auth_required","unauthorized","forbidden","not_found","bad_request"]}
{"schemaVersion":1,"path":"project delete","aliases":[],"summary":"Delete a project with all its versions","description":"Deletes the project. On a terminal it asks you to type the id or slug as given; otherwise it needs --yes.","endpoints":[{"method":"DELETE","path":"/project/{id|slug}","scope":"PROJECT_DELETE"}],"args":[{"name":"id","required":true,"variadic":false,"help":"project id (8-char base62) or slug"}],"flags":[],"output":{"shape":"ack","default_fields":null,"fields":[]},"mutating":"destructive","requires_yes":true,"supports_dry_run":true,"examples":["mdr project delete my-test-mod --yes","mdr project delete my-test-mod --dry-run"],"errors":["auth_required","unauthorized","forbidden","not_found","bad_request","confirmation_required"]}
{"schemaVersion":1,"path":"version list","aliases":["version ls"],"summary":"List the versions of a project, newest first","description":"Lists versions newest first. --loader and --game-version are sent to the API; --version-type and --limit are applied by mdr afterwards. Changelogs are not requested unless --fields includes changelog or --full is given.","endpoints":[{"method":"GET","path":"/project/{id|slug}/version","scope":null}],"args":[{"name":"project","required":true,"variadic":false,"help":"project id or slug"}],"flags":[{"name":"--loader","type":"list","help":"loader, e.g. fabric (repeatable, OR)"},{"name":"--game-version","type":"list","help":"game version, e.g. 1.20.1 (repeatable, OR)"},{"name":"--featured","type":"bool","help":"only featured versions"},{"name":"--version-type","type":"list","help":"release, beta or alpha (repeatable, OR)"},{"name":"--limit","type":"int","default":"20","help":"at most this many versions, 0-10000; 0 = all"}],"output":{"shape":"array","default_fields":["id","project_id","version_number","name","version_type","loaders","game_versions","date_published","downloads"],"fields":["id","project_id","author_id","name","version_number","changelog","changelog_url","date_published","downloads","version_type","status","requested_status","featured","game_versions","loaders","environment","dependencies.version_id","dependencies.project_id","dependencies.file_name","dependencies.dependency_type","files.id","files.hashes.sha1","files.hashes.sha512","files.url","files.filename","files.primary","files.size","files.file_type"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr version list sodium --loader fabric --game-version 1.20.1 --version-type release --limit 1","mdr version ls sodium --limit 0 --fields id,version_number"],"errors":["not_found"]}
{"schemaVersion":1,"path":"version get","aliases":[],"summary":"Get one version by id, or by project and version number","description":"With one argument, looks the version up by id. With two, looks up the version of the project with that version number.","endpoints":[{"method":"GET","path":"/version/{id}","scope":null},{"method":"GET","path":"/project/{id|slug}/version/{id|number}","scope":null}],"args":[{"name":"id","required":true,"variadic":false,"help":"version id, or the project id or slug when <number> is given"},{"name":"number","required":false,"variadic":false,"help":"version number, e.g. mc1.20.1-0.5.11"}],"flags":[],"output":{"shape":"object","default_fields":["id","project_id","version_number","name","version_type","status","featured","loaders","game_versions","date_published","downloads","dependencies","files.filename","files.url","files.size","files.primary","files.hashes.sha512"],"fields":["id","project_id","author_id","name","version_number","changelog","changelog_url","date_published","downloads","version_type","status","requested_status","featured","game_versions","loaders","environment","dependencies.version_id","dependencies.project_id","dependencies.file_name","dependencies.dependency_type","files.id","files.hashes.sha1","files.hashes.sha512","files.url","files.filename","files.primary","files.size","files.file_type"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr version get ygf8cVZg","mdr version get sodium mc1.20.1-0.5.11"],"errors":["not_found"]}
{"schemaVersion":1,"path":"version get-many","aliases":[],"summary":"Get several versions by id","description":"Fetches up to 1000 versions, 100 per request. The output keeps the order of the arguments; ids that match nothing are left out and listed in a note on stderr (exit 0).","endpoints":[{"method":"GET","path":"/versions","scope":null}],"args":[{"name":"id","required":true,"variadic":true,"help":"version ids (1-1000)"}],"flags":[],"output":{"shape":"array","default_fields":["id","project_id","version_number","name","version_type","loaders","game_versions","date_published","downloads"],"fields":["id","project_id","author_id","name","version_number","changelog","changelog_url","date_published","downloads","version_type","status","requested_status","featured","game_versions","loaders","environment","dependencies.version_id","dependencies.project_id","dependencies.file_name","dependencies.dependency_type","files.id","files.hashes.sha1","files.hashes.sha512","files.url","files.filename","files.primary","files.size","files.file_type"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr version get-many ygf8cVZg OihdIimA"],"errors":[]}
{"schemaVersion":1,"path":"version download","aliases":[],"summary":"Download the files of a version and verify their hashes","description":"Downloads the primary file of the version (or --file / --all) from the Modrinth CDN into --dir, which must exist. Each file is written to a temporary file in --dir, checked against the size and hash the API gives, and renamed into place; nothing is left behind on failure. A file that is already there with the same content is not downloaded again (status exists); one with different content is an error (file_exists) unless --force. No token is sent to the CDN.","endpoints":[{"method":"GET","path":"/version/{id}","scope":null}],"args":[{"name":"id","required":true,"variadic":false,"help":"version id"}],"flags":[{"name":"--dir","type":"string","default":".","help":"existing directory to save into"},{"name":"--file","type":"string","help":"only the file with this exact file name"},{"name":"--all","type":"bool","help":"all files of the version, not only the primary one"},{"name":"--force","type":"bool","help":"overwrite existing files with different content"}],"output":{"shape":"array","default_fields":null,"fields":["version_id","filename","path","size","sha512","status"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr version download ygf8cVZg --dir mods","mdr version download ygf8cVZg --all --dir mods --force"],"errors":["not_found","file_exists","hash_mismatch","io_error","interrupted"]}
{"schemaVersion":1,"path":"version create","aliases":[],"summary":"Upload a new version of a project","description":"Uploads the files (--file, repeatable) and the version metadata as one multipart request. A project slug is first resolved to its id (GET /project/{slug}/check, also with --dry-run); an 8-character id is used as is. The first --file is the primary file unless --primary names another. --data passes the whole metadata object instead of the content flags; mdr still sets project_id, file_parts and primary_file. Prints the created version.","endpoints":[{"method":"POST","path":"/version","scope":"VERSION_CREATE"},{"method":"GET","path":"/project/{id|slug}/check","scope":null}],"args":[{"name":"project","required":true,"variadic":false,"help":"project id or slug"}],"flags":[{"name":"--file","type":"list","help":"file to upload: .jar, .zip, .mrpack or .litemod (repeatable, required)"},{"name":"--version-number","type":"string","help":"version number, e.g. 1.2.0 (required)"},{"name":"--name","type":"string","help":"display name (default: the version number)"},{"name":"--loader","type":"list","help":"loader, e.g. fabric (repeatable, required)"},{"name":"--game-version","type":"list","help":"game version, e.g. 1.20.1 (repeatable, required)"},{"name":"--version-type","type":"enum","values":["release","beta","alpha"],"default":"release","help":"release, beta or alpha"},{"name":"--changelog","type":"string","help":"changelog (Markdown)"},{"name":"--changelog-file","type":"string","help":"read the changelog from a file or stdin"},{"name":"--dependency","type":"list","help":"dependency; type is required, optional, incompatible or embedded (repeatable)"},{"name":"--featured","type":"bool","help":"feature the version"},{"name":"--status","type":"string","help":"listed, archived, draft or unlisted"},{"name":"--primary","type":"string","help":"the --file that is the primary file (default: the first)"},{"name":"--data","type":"string","help":"version metadata as a JSON object, from a file or stdin (instead of the content flags)"}],"output":{"shape":"object","default_fields":["id","project_id","version_number","name","version_type","status","featured","loaders","game_versions","date_published","downloads","dependencies","files.filename","files.url","files.size","files.primary","files.hashes.sha512"],"fields":["id","project_id","author_id","name","version_number","changelog","changelog_url","date_published","downloads","version_type","status","requested_status","featured","game_versions","loaders","environment","dependencies.version_id","dependencies.project_id","dependencies.file_name","dependencies.dependency_type","files.id","files.hashes.sha1","files.hashes.sha512","files.url","files.filename","files.primary","files.size","files.file_type"]},"mutating":"write","requires_yes":false,"supports_dry_run":true,"examples":["mdr version create my-mod --file build/libs/my-mod-1.2.0.jar --version-number 1.2.0 --loader fabric --game-version 1.20.1","mdr version create AABBCCDD --file a.jar --file a-sources.jar --version-number 1.2.0 --loader fabric --game-version 1.20.1 --version-type beta --changelog-file CHANGELOG.md --dry-run"],"errors":["auth_required","unauthorized","forbidden","not_found","bad_request"]}
{"schemaVersion":1,"path":"version add-file","aliases":[],"summary":"Upload more files to an existing version","description":"Uploads the files (--file, repeatable) to the version as one multipart request. Prints an ack on success.","endpoints":[{"method":"POST","path":"/version/{id}/file","scope":"VERSION_WRITE"}],"args":[{"name":"id","required":true,"variadic":false,"help":"version id"}],"flags":[{"name":"--file","type":"list","help":"file to upload: .jar, .zip, .mrpack or .litemod (repeatable, required)"}],"output":{"shape":"ack","default_fields":null,"fields":[]},"mutating":"write","requires_yes":false,"supports_dry_run":true,"examples":["mdr version add-file IIJJKKLL --file build/libs/my-mod-1.2.0-sources.jar"],"errors":["auth_required","unauthorized","forbidden","not_found","bad_request"]}
{"schemaVersion":1,"path":"version edit","aliases":[],"summary":"Change fields of a version","description":"Sends only the given fields (PATCH). Values of --set are read like api -f. The default output of get does not include long text fields such as body or changelog; fetch them with --fields body (or --fields changelog) before editing them. Prints an ack on success.","endpoints":[{"method":"PATCH","path":"/version/{id}","scope":"VERSION_WRITE"}],"args":[{"name":"id","required":true,"variadic":false,"help":"version id"}],"flags":[{"name":"--set","type":"list","help":"set a field: key=value (repeatable); true/false/null, numbers and JSON ([...], {...}, \"...\") are sent as JSON, anything else as a string"},{"name":"--data","type":"string","help":"fields to change as a JSON object, from a file or stdin (instead of --set)"}],"output":{"shape":"ack","default_fields":null,"fields":[]},"mutating":"write","requires_yes":false,"supports_dry_run":true,"examples":["mdr version edit IIJJKKLL --set featured=true --set version_type=beta","mdr version edit IIJJKKLL --set 'game_versions=[\"1.20.1\",\"1.20.2\"]' --dry-run"],"errors":["auth_required","unauthorized","forbidden","not_found","bad_request"]}
{"schemaVersion":1,"path":"version delete","aliases":[],"summary":"Delete a version and its files","description":"Deletes the version. On a terminal it asks you to type the id; otherwise it needs --yes.","endpoints":[{"method":"DELETE","path":"/version/{id}","scope":"VERSION_DELETE"}],"args":[{"name":"id","required":true,"variadic":false,"help":"version id"}],"flags":[],"output":{"shape":"ack","default_fields":null,"fields":[]},"mutating":"destructive","requires_yes":true,"supports_dry_run":true,"examples":["mdr version delete IIJJKKLL --yes","mdr version delete IIJJKKLL --dry-run"],"errors":["auth_required","unauthorized","forbidden","not_found","bad_request","confirmation_required"]}
{"schemaVersion":1,"path":"file get","aliases":[],"summary":"Get the version that has a file with this hash","description":"","endpoints":[{"method":"GET","path":"/version_file/{hash}","scope":null}],"args":[{"name":"hash","required":true,"variadic":false,"help":"sha1 (40 hex digits) or sha512 (128 hex digits)"}],"flags":[{"name":"--algorithm","type":"enum","values":["sha1","sha512"],"help":"hash algorithm; default: from the length (40 = sha1, 128 = sha512)"}],"output":{"shape":"object","default_fields":["id","project_id","version_number","name","version_type","loaders","game_versions","date_published","downloads"],"fields":["id","project_id","author_id","name","version_number","changelog","changelog_url","date_published","downloads","version_type","status","requested_status","featured","game_versions","loaders","environment","dependencies.version_id","dependencies.project_id","dependencies.file_name","dependencies.dependency_type","files.id","files.hashes.sha1","files.hashes.sha512","files.url","files.filename","files.primary","files.size","files.file_type"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr file get c4293c1483f3b39c1c6c4c69143e8bb2c6e53daf"],"errors":["not_found"]}
{"schemaVersion":1,"path":"file identify","aliases":[],"summary":"Find the project and version of local files","description":"Hashes each file and asks Modrinth which version it belongs to, 100 hashes per request. Arguments are files or directories; a directory contributes the files directly in it (not in subdirectories) ending in .jar, .zip, .mrpack or .litemod, also with .disabled appended. Only the hashes of the files are sent, never their content. Files Modrinth does not know get matched: false; the exit code is still 0.","endpoints":[{"method":"POST","path":"/version_files","scope":null},{"method":"GET","path":"/projects","scope":null}],"args":[{"name":"path","required":true,"variadic":true,"help":"files or directories"}],"flags":[{"name":"--algorithm","type":"enum","values":["sha1","sha512"],"default":"sha512","help":"hash algorithm sent to the API"},{"name":"--no-project","type":"bool","help":"do not look up the project slug and title (one request fewer)"}],"output":{"shape":"array","default_fields":["path","matched","project_id","project_slug","version_id","version_number","loaders","game_versions"],"fields":["path","filename","size","sha1","sha512","matched","project_id","project_slug","project_title","version_id","version_number","version_name","version_type","loaders","game_versions","date_published"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr file identify mods/","mdr file identify mods/sodium.jar --fields path,project_slug,version_number"],"errors":["io_error"]}
{"schemaVersion":1,"path":"file updates","aliases":[],"summary":"Check local files for newer versions","description":"Looks up the version of each file, then the newest version of its project for the given loaders and game versions (both required by the API). Arguments are files or directories; a directory contributes the files directly in it (not in subdirectories) ending in .jar, .zip, .mrpack or .litemod, also with .disabled appended. Only the hashes of the files are sent, never their content. status is up_to_date, update_available, no_compatible_version (nothing for these loaders and game versions) or unknown (not on Modrinth); the exit code is 0 either way. Nothing is downloaded: pass latest.version_id to mdr version download.","endpoints":[{"method":"POST","path":"/version_files","scope":null},{"method":"POST","path":"/version_files/update","scope":null},{"method":"GET","path":"/projects","scope":null}],"args":[{"name":"path","required":true,"variadic":true,"help":"files or directories"}],"flags":[{"name":"--loader","type":"list","help":"loader, e.g. fabric (repeatable, required)"},{"name":"--game-version","type":"list","help":"game version, e.g. 1.20.1 (repeatable, required)"},{"name":"--version-type","type":"list","help":"release, beta or alpha (repeatable); default: all"},{"name":"--algorithm","type":"enum","values":["sha1","sha512"],"default":"sha512","help":"hash algorithm sent to the API"},{"name":"--only-updates","type":"bool","help":"only output files with status update_available"},{"name":"--no-project","type":"bool","help":"do not look up the project slug and title (one request fewer)"}],"output":{"shape":"array","default_fields":["path","status","project_id","project_slug","current.version_id","current.version_number","latest.version_id","latest.version_number","latest.filename"],"fields":["path","filename","size","sha512","status","project_id","project_slug","project_title","current.version_id","current.version_number","current.date_published","latest.version_id","latest.version_number","latest.version_type","latest.date_published","latest.filename","latest.url","latest.size","latest.sha512"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr file updates mods/ --loader fabric --game-version 1.20.1","mdr file updates mods/ --loader fabric --game-version 1.20.1 --version-type release --only-updates"],"errors":["io_error"]}
{"schemaVersion":1,"path":"user me","aliases":["whoami"],"summary":"Show the user the token belongs to","description":"Needs a token (MODRINTH_TOKEN or mdr auth login); without one it fails with auth_required before sending anything.","endpoints":[{"method":"GET","path":"/user","scope":"USER_READ"}],"args":[],"flags":[],"output":{"shape":"object","default_fields":["id","username","name","email","role","created"],"fields":["id","username","name","email","bio","avatar_url","created","role","badges","auth_providers","email_verified","has_password","has_totp","github_id","payout_data.balance","payout_data.payout_wallet","payout_data.payout_wallet_type","payout_data.payout_address"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr user me","mdr whoami --fields username"],"errors":["auth_required","unauthorized"]}
{"schemaVersion":1,"path":"user get","aliases":[],"summary":"Get one user by id or username","description":"","endpoints":[{"method":"GET","path":"/user/{id|username}","scope":null}],"args":[{"name":"user","required":true,"variadic":false,"help":"user id or username"}],"flags":[],"output":{"shape":"object","default_fields":["id","username","name","bio","role","created"],"fields":["id","username","name","email","bio","avatar_url","created","role","badges","auth_providers","email_verified","has_password","has_totp","github_id","payout_data.balance","payout_data.payout_wallet","payout_data.payout_wallet_type","payout_data.payout_address"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr user get jellysquid3"],"errors":["not_found"]}
{"schemaVersion":1,"path":"user get-many","aliases":[],"summary":"Get several users by id or username","description":"Fetches up to 1000 users, 100 per request. The output keeps the order of the arguments; users that match nothing are left out and listed in a note on stderr (exit 0).","endpoints":[{"method":"GET","path":"/users","scope":null}],"args":[{"name":"user","required":true,"variadic":true,"help":"user ids or usernames (1-1000)"}],"flags":[],"output":{"shape":"array","default_fields":["id","username","name","bio","role","created"],"fields":["id","username","name","email","bio","avatar_url","created","role","badges","auth_providers","email_verified","has_password","has_totp","github_id","payout_data.balance","payout_data.payout_wallet","payout_data.payout_wallet_type","payout_data.payout_address"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr user get-many jellysquid3 TEZXhE2U"],"errors":[]}
{"schemaVersion":1,"path":"user projects","aliases":[],"summary":"List the projects of a user","description":"","endpoints":[{"method":"GET","path":"/user/{id|username}/projects","scope":null}],"args":[{"name":"user","required":true,"variadic":false,"help":"user id or username"}],"flags":[{"name":"--limit","type":"int","default":"50","help":"at most this many projects, 0-10000; 0 = all"}],"output":{"shape":"array","default_fields":["id","slug","title","description","project_type","downloads","followers","categories","loaders","license.id","client_side","server_side","status","updated","team","source_url"],"fields":["id","slug","project_type","team","organization","title","description","body","body_url","published","updated","approved","queued","status","requested_status","moderator_message.message","moderator_message.body","license.id","license.name","license.url","client_side","server_side","environment","downloads","followers","categories","additional_categories","game_versions","loaders","versions","icon_url","raw_icon_url","color","thread_id","monetization_status","issues_url","source_url","wiki_url","discord_url","donation_urls.id","donation_urls.platform","donation_urls.url","gallery.url","gallery.raw_url","gallery.featured","gallery.title","gallery.description","gallery.created","gallery.ordering"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr user projects jellysquid3"],"errors":["not_found"]}
{"schemaVersion":1,"path":"team members","aliases":[],"summary":"List the members of a team","description":"Takes a team id (the team field of a project). For a project's members use: mdr project members <project>.","endpoints":[{"method":"GET","path":"/team/{id}/members","scope":null}],"args":[{"name":"team-id","required":true,"variadic":false,"help":"team id (8-char base62)"}],"flags":[],"output":{"shape":"array","default_fields":["user.id","user.username","role","accepted","ordering"],"fields":["team_id","user.id","user.username","user.name","user.avatar_url","user.raw_avatar_url","user.bio","user.created","user.role","user.badges","user.campaigns","user.auth_providers","user.email","user.email_verified","user.has_password","user.has_totp","user.payout_data","user.stripe_customer_id","user.allow_friend_requests","user.eligibility_verified_at","user.github_id","role","permissions","accepted","payouts_split","ordering"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr team members 4reLOAKe"],"errors":["not_found"]}
{"schemaVersion":1,"path":"tag list","aliases":[],"summary":"List the tags of one kind","description":"Kinds: category, loader, game-version, license, donation-platform, report-type, project-type, side-type. report-type, project-type and side-type are arrays of strings (no --fields). Filters are applied by mdr.","endpoints":[{"method":"GET","path":"/tag/category","scope":null},{"method":"GET","path":"/tag/loader","scope":null},{"method":"GET","path":"/tag/game_version","scope":null},{"method":"GET","path":"/tag/license","scope":null},{"method":"GET","path":"/tag/donation_platform","scope":null},{"method":"GET","path":"/tag/report_type","scope":null},{"method":"GET","path":"/tag/project_type","scope":null},{"method":"GET","path":"/tag/side_type","scope":null}],"args":[{"name":"kind","required":true,"variadic":false,"help":"tag kind: category, loader, game-version, license, donation-platform, report-type, project-type, side-type"}],"flags":[{"name":"--project-type","type":"string","help":"category and loader only: tags for this project type"},{"name":"--version-type","type":"enum","values":["release","snapshot","alpha","beta"],"help":"game-version only: versions of this type"},{"name":"--limit","type":"int","help":"at most this many tags, 0-10000; 0 = all (default 30 for game-version, else 0)"}],"output":{"shape":"array","default_fields":null,"fields":["icon","name","project_type","header","supported_project_types","version","version_type","date","major","short"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr tag list game-version --version-type release --limit 5","mdr tag list category --project-type mod --fields name,header","mdr tag list loader"],"errors":[]}
{"schemaVersion":1,"path":"tag license","aliases":[],"summary":"Get the title and text of a license","description":"The text (body) is long, so the default output has only the title; use --full or --fields body.","endpoints":[{"method":"GET","path":"/tag/license/{id}","scope":null}],"args":[{"name":"spdx-id","required":true,"variadic":false,"help":"SPDX license id, e.g. MIT or LGPL-3.0-or-later"}],"flags":[],"output":{"shape":"object","default_fields":["title"],"fields":["title","body"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr tag license MIT","mdr tag license LGPL-3.0-or-later --full"],"errors":["not_found","bad_request"]}
{"schemaVersion":1,"path":"stats","aliases":[],"summary":"Show site-wide counts of projects, versions, files, authors","description":"","endpoints":[{"method":"GET","path":"/statistics","scope":null}],"args":[],"flags":[],"output":{"shape":"object","default_fields":["projects","versions","files","authors"],"fields":["projects","versions","files","authors"]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr stats"],"errors":[]}
{"schemaVersion":1,"path":"auth login","aliases":[],"summary":"Check a token from stdin and save it","description":"Reads a personal access token from the first line of stdin, checks it with GET /user and saves it in plain text to credentials.json in the config directory (0600). With --staging the staging token is saved. The token is never taken as an argument. For agents and CI prefer MODRINTH_TOKEN or MODRINTH_TOKEN_FILE.","endpoints":[{"method":"GET","path":"/user","scope":"USER_READ"}],"args":[],"flags":[{"name":"--with-token","type":"bool","help":"read the token from stdin (required)"}],"output":{"shape":"ack","default_fields":null,"fields":[]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr auth login --with-token < token.txt","mdr auth login --with-token --staging < staging-token.txt"],"errors":["usage","invalid_input","unauthorized","io_error"]}
{"schemaVersion":1,"path":"auth status","aliases":[],"summary":"Show whether a token is set and whose it is","description":"Without a token, prints authenticated: false (exit 0) and sends nothing. With one, checks it with GET /user; a rejected token fails with unauthorized (exit 4). token is masked (mrp_…wxyz). token_source is env (MODRINTH_TOKEN / MODRINTH_STAGING_TOKEN), token_file (MODRINTH_TOKEN_FILE / MODRINTH_STAGING_TOKEN_FILE) or file (credentials.json).","endpoints":[{"method":"GET","path":"/user","scope":"USER_READ"}],"args":[],"flags":[],"output":{"shape":"raw","default_fields":null,"fields":[]},"mutating":false,"requires_yes":false,"supports_dry_run":true,"examples":["mdr auth status","mdr auth status --staging"],"errors":["unauthorized"]}
{"schemaVersion":1,"path":"auth logout","aliases":[],"summary":"Remove the saved token","description":"Removes the token (with --staging, the staging token) from credentials.json, and the file when nothing is left in it. Token environment variables are not affected.","endpoints":[],"args":[],"flags":[],"output":{"shape":"ack","default_fields":null,"fields":[]},"mutating":false,"requires_yes":false,"supports_dry_run":false,"examples":["mdr auth logout","mdr auth logout --staging"],"errors":["io_error"]}
{"schemaVersion":1,"path":"config get","aliases":[],"summary":"Show the resolved value of a setting and its source","description":"Precedence per key: flag > environment variable > config.json > default. source is flag, env, file or default.","endpoints":[],"args":[{"name":"key","required":true,"variadic":false,"help":"config key: output, staging, user_agent_contact, timeout, max_wait"}],"flags":[],"output":{"shape":"object","default_fields":null,"fields":["key","value","source"]},"mutating":false,"requires_yes":false,"supports_dry_run":false,"examples":["mdr config get timeout"],"errors":["usage"]}
{"schemaVersion":1,"path":"config set","aliases":[],"summary":"Save a setting to config.json","description":"Values: output auto|json|ndjson|table; staging true|false; user_agent_contact an email address or URL; timeout 1-3600 and max_wait 0-3600 (integer seconds). Other keys in the file are kept.","endpoints":[],"args":[{"name":"key","required":true,"variadic":false,"help":"config key: output, staging, user_agent_contact, timeout, max_wait"},{"name":"value","required":true,"variadic":false,"help":"new value"}],"flags":[],"output":{"shape":"ack","default_fields":null,"fields":[]},"mutating":false,"requires_yes":false,"supports_dry_run":false,"examples":["mdr config set timeout 60","mdr config set user_agent_contact you@example.com"],"errors":["usage","invalid_input","io_error"]}
{"schemaVersion":1,"path":"config unset","aliases":[],"summary":"Remove a setting from config.json","description":"","endpoints":[],"args":[{"name":"key","required":true,"variadic":false,"help":"config key: output, staging, user_agent_contact, timeout, max_wait"}],"flags":[],"output":{"shape":"ack","default_fields":null,"fields":[]},"mutating":false,"requires_yes":false,"supports_dry_run":false,"examples":["mdr config unset timeout"],"errors":["usage","io_error"]}
{"schemaVersion":1,"path":"config list","aliases":[],"summary":"Show every setting with its value and source","description":"Tokens are not listed; see mdr auth status.","endpoints":[],"args":[],"flags":[],"output":{"shape":"array","default_fields":null,"fields":["key","value","source"]},"mutating":false,"requires_yes":false,"supports_dry_run":false,"examples":["mdr config list","mdr config list -o table"],"errors":[]}
{"schemaVersion":1,"path":"config path","aliases":[],"summary":"Show where the config files are","description":"The directory is MODRINTH_CONFIG_DIR, else <user config dir>/modrinth-cli: $XDG_CONFIG_HOME or ~/.config on Linux, %AppData% on Windows, ~/Library/Application Support on macOS. The files need not exist.","endpoints":[],"args":[],"flags":[],"output":{"shape":"raw","default_fields":null,"fields":[]},"mutating":false,"requires_yes":false,"supports_dry_run":false,"examples":["mdr config path"],"errors":["io_error"]}
{"schemaVersion":1,"path":"api","aliases":[],"summary":"Call any API endpoint and print the response","description":"Sends a request to the given path with the same User-Agent, authentication, error format and exit codes as the other commands. JSON responses keep the API's key order; other bodies are printed as is. Methods other than GET and HEAD may change data on Modrinth: mdr does not ask for confirmation, so preview them with --dry-run. -f builds a JSON body, -F a multipart body (k=@path for a file), --input sends a file or stdin as is; they cannot be combined. --fields selects keys of a JSON response (dotted paths, through arrays), checked against the response itself.","endpoints":[],"args":[{"name":"path","required":true,"variadic":false,"help":"endpoint path without the version, e.g. /project/sodium"}],"flags":[{"name":"--method","short":"-X","type":"string","help":"GET, POST, PATCH, PUT, DELETE or HEAD (default GET, or POST with -f, -F or --input)"},{"name":"--query","type":"list","help":"add a query parameter (repeatable)"},{"name":"--field","short":"-f","type":"list","help":"add a JSON body field; values are read like --set (repeatable)"},{"name":"--form","short":"-F","type":"list","help":"add a multipart part; @path uploads a file (repeatable)"},{"name":"--input","type":"string","help":"send a file (or stdin) as the body; Content-Type application/json unless -H sets it"},{"name":"--header","short":"-H","type":"list","help":"add a request header (repeatable)"},{"name":"--api-version","type":"enum","values":["v2","v3","none"],"default":"v2","help":"API version prefix of the path; none calls the path from the API root, e.g. /updates/{id}/forge_updates.json"},{"name":"--include","short":"-i","type":"bool","help":"print the status line and response headers to stderr"},{"name":"--paginate","type":"bool","help":"GET only: fetch every page of a hits/offset/limit/total_hits response (up to 1000 hits) as NDJSON"}],"output":{"shape":"raw","default_fields":null,"fields":[]},"mutating":false,"requires_yes":false,"supports_dry_run":false,"examples":["mdr api /project/sodium","mdr api /search --query query=sodium --query limit=5","mdr api /search --query query=sodium --paginate","mdr api --api-version v3 /project/sodium","mdr api --api-version none /updates/sodium/forge_updates.json","mdr api /project/sodium/version --fields version_number,date_published","mdr api -X PATCH /project/AANobbMI -f title=\"New title\" --dry-run","mdr api -X POST /version -F data=@version.json -F file0=@build/mod.jar --dry-run"],"errors":["not_found","auth_required","bad_request"]}
{"schemaVersion":1,"path":"completion","aliases":[],"summary":"Print a shell completion script","description":"Prints a static completion script for bash, zsh, fish or PowerShell, generated from the command table: commands, flags, enum values and tag kinds. It calls no API. bash: source <(mdr completion bash). zsh: mdr completion zsh > \"${fpath[1]}/_mdr\". fish: mdr completion fish > ~/.config/fish/completions/mdr.fish. PowerShell: mdr completion powershell | Out-String | Invoke-Expression (add it to $PROFILE).","endpoints":[],"args":[{"name":"shell","required":true,"variadic":false,"help":"bash, zsh, fish or powershell"}],"flags":[],"output":{"shape":"raw","default_fields":null,"fields":[]},"mutating":false,"requires_yes":false,"supports_dry_run":false,"examples":["mdr completion bash","mdr completion zsh"],"errors":["usage"]}
{"schemaVersion":1,"path":"schema","aliases":["describe"],"summary":"Describe commands as JSON (for agents and scripts)","description":"Without arguments, lists every command in one JSON object. With a command path, describes that command: arguments, flags, output fields and examples. Always prints JSON, whatever --output says. Does not use the network.","endpoints":[],"args":[{"name":"command","required":false,"variadic":true,"help":"command path, e.g. \"project get\""}],"flags":[{"name":"--all","type":"bool","help":"describe every command, one JSON object per line"}],"output":{"shape":"raw","default_fields":null,"fields":[]},"mutating":false,"requires_yes":false,"supports_dry_run":false,"examples":["mdr schema","mdr schema schema","mdr schema --all"],"errors":["usage"]}
