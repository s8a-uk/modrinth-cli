{"schemaVersion":1,"name":"mdr","version":"<VERSION>","api":{"base_url":"https://api.modrinth.com/v2","staging_url":"https://staging-api.modrinth.com/v2"},"global_flags":[{"name":"--output","short":"-o","type":"enum","values":["auto","json","ndjson","table"],"default":"auto","help":"output format; auto: table on a terminal, json otherwise; do not parse table"},{"name":"--fields","type":"list","help":"select output fields (comma-separated paths, or all)"},{"name":"--full","type":"bool","help":"output all fields (same as --fields all)"},{"name":"--staging","type":"bool","help":"use the staging API (staging-api.modrinth.com)"},{"name":"--dry-run","type":"bool","help":"print the request that would be sent instead of sending it"},{"name":"--yes","short":"-y","type":"bool","help":"skip the confirmation of destructive commands"},{"name":"--timeout","type":"int","default":"30","help":"per-request timeout in seconds, 1-3600"},{"name":"--max-wait","type":"int","default":"60","help":"max seconds to wait on rate limits in total, 0-3600"},{"name":"--no-retry","type":"bool","help":"disable automatic retries"},{"name":"--verbose","short":"-v","type":"bool","help":"log requests to stderr"},{"name":"-vv","type":"bool","help":"log requests and headers to stderr"},{"name":"--quiet","short":"-q","type":"bool","help":"suppress notes on stderr (errors are still printed)"},{"name":"--no-color","type":"bool","help":"disable colors (also NO_COLOR)"},{"name":"--help","short":"-h","type":"bool","help":"show help"},{"name":"--version","type":"bool","help":"print the mdr version"}],"exit_codes":{"0":"success","1":"internal","2":"usage","3":"not_found","4":"auth","5":"api_rejected","6":"rate_limited","7":"network","8":"server_error","9":"hash_mismatch","130":"interrupted"},"error_shape":{"stream":"stderr","keys":["code","message","http_status","retryable","retry_after_s","hint","request","api_error","api_description","api_details","body_excerpt"]},"commands":[{"path":"search","summary":"Search projects","mutating":false},{"path":"project get","summary":"Get one project by id or slug","mutating":false},{"path":"project get-many","summary":"Get several projects by id or slug","mutating":false},{"path":"project random","summary":"Get random projects","mutating":false},{"path":"project check","summary":"Check that a project exists and get its id","mutating":false},{"path":"project dependencies","summary":"List the projects and versions a project depends on","mutating":false},{"path":"project members","summary":"List the team members of a project","mutating":false},{"path":"project create","summary":"Create a project from a JSON description","mutating":"write","scope":"PROJECT_CREATE"},{"path":"project edit","summary":"Change fields of a project","mutating":"write","scope":"PROJECT_WRITE"},{"path":"project delete","summary":"Delete a project with all its versions","mutating":"destructive","scope":"PROJECT_DELETE"},{"path":"version list","summary":"List the versions of a project, newest first","mutating":false},{"path":"version get","summary":"Get one version by id, or by project and version number","mutating":false},{"path":"version get-many","summary":"Get several versions by id","mutating":false},{"path":"version download","summary":"Download the files of a version and verify their hashes","mutating":false},{"path":"version create","summary":"Upload a new version of a project","mutating":"write","scope":"VERSION_CREATE"},{"path":"version add-file","summary":"Upload more files to an existing version","mutating":"write","scope":"VERSION_WRITE"},{"path":"version edit","summary":"Change fields of a version","mutating":"write","scope":"VERSION_WRITE"},{"path":"version delete","summary":"Delete a version and its files","mutating":"destructive","scope":"VERSION_DELETE"},{"path":"file get","summary":"Get the version that has a file with this hash","mutating":false},{"path":"file identify","summary":"Find the project and version of local files","mutating":false},{"path":"file updates","summary":"Check local files for newer versions","mutating":false},{"path":"user me","summary":"Show the user the token belongs to","mutating":false,"scope":"USER_READ"},{"path":"user get","summary":"Get one user by id or username","mutating":false},{"path":"user get-many","summary":"Get several users by id or username","mutating":false},{"path":"user projects","summary":"List the projects of a user","mutating":false},{"path":"team members","summary":"List the members of a team","mutating":false},{"path":"tag list","summary":"List the tags of one kind","mutating":false},{"path":"tag license","summary":"Get the title and text of a license","mutating":false},{"path":"stats","summary":"Show site-wide counts of projects, versions, files, authors","mutating":false},{"path":"auth login","summary":"Check a token from stdin and save it","mutating":false,"scope":"USER_READ"},{"path":"auth status","summary":"Show whether a token is set and whose it is","mutating":false,"scope":"USER_READ"},{"path":"auth logout","summary":"Remove the saved token","mutating":false},{"path":"config get","summary":"Show the resolved value of a setting and its source","mutating":false},{"path":"config set","summary":"Save a setting to config.json","mutating":false},{"path":"config unset","summary":"Remove a setting from config.json","mutating":false},{"path":"config list","summary":"Show every setting with its value and source","mutating":false},{"path":"config path","summary":"Show where the config files are","mutating":false},{"path":"api","summary":"Call any API endpoint and print the response","mutating":false},{"path":"completion","summary":"Print a shell completion script","mutating":false},{"path":"schema","summary":"Describe commands as JSON (for agents and scripts)","mutating":false}]}
